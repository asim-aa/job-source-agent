# LinkedIn ingestion provider. "mock" reads job_agent/fixtures/linkedin_job_listings.json
# and needs no key. Set to a real provider name once one is implemented (see
# job_agent/stages/linkedin_ingestion.py get_provider()).
LINKEDIN_PROVIDER=mock

# Stage 3 (career page discovery) LLM classification. Two providers, switched
# via LLM_PROVIDER (default "anthropic" if unset):
LLM_PROVIDER=anthropic

# Provider "anthropic": get a key at https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Provider "supportvectors": an OpenAI-compatible gateway (e.g. a bootcamp-
# provided endpoint). Requires being on the required network/VPN if applicable.
# SUPPORTVECTORS_BASE_URL=your_supportvectors_base_url_here
# SUPPORTVECTORS_API_KEY=your_supportvectors_api_key_here
# SUPPORTVECTORS_MODEL=openai/gpt-oss-20b

# A missing/misconfigured LLM provider skips gracefully with a printed
# warning per call, rather than crashing the run.
