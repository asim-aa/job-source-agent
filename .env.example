# LinkedIn ingestion provider. "mock" reads job_agent/fixtures/linkedin_job_listings.json
# and needs no key. Set to a real provider name once one is implemented (see
# job_agent/stages/linkedin_ingestion.py get_provider()).
LINKEDIN_PROVIDER=mock

# Used by stage 3 (career page discovery, later phase) for LLM-driven link
# selection when the heuristic crawl can't find a careers link.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
